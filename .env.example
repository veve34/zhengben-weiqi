# 服务端口
PORT=3000

# JWT 会员登录密钥，正式环境务必换成随机长字符串
JWT_SECRET=change-this-to-a-long-random-string

# 管理后台密码（简易 MVP 用，正式环境建议改为独立管理员帐号表 + 雜湊密码）
ADMIN_PASSWORD=change-this-admin-password

# 身份证号加密密钥，至少32字符，正式环境务必换成随机长字符串并妥善保管
# （身份证号用可逆加密存储，而非雜湊，以便日后合规查验需要时可还原）
ID_ENCRYPTION_KEY=change-this-to-a-random-32-character-or-longer-string
