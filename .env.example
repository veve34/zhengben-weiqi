# 服务端口
PORT=3000

# JWT 会员登录密钥，正式环境务必换成随机长字符串
JWT_SECRET=change-this-to-a-long-random-string

# 管理后台密码（简易 MVP 用，正式环境建议改为独立管理员帐号表 + 雜湊密码）
ADMIN_PASSWORD=change-this-admin-password

# ---- 短信服务商配置（以阿里云短信服务为例，实际串接时取消注释并填入）----
# SMS_PROVIDER=aliyun
# ALIYUN_ACCESS_KEY_ID=xxxxxxxx
# ALIYUN_ACCESS_KEY_SECRET=xxxxxxxx
# SMS_SIGN_NAME=正本围棋
# SMS_TEMPLATE_CODE=SMS_XXXXXXX

# 未配置短信服务商时，验证码会打印在服务器控制台（仅供开发测试，正式环境务必配置真实服务商）
